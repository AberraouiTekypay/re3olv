# Runtime connection (use your provider's pooled URL, usually port 6543).
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/DATABASE?sslmode=require

# Prisma CLI migrations and seed (direct database connection).
DIRECT_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/DATABASE?sslmode=require

DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_TRANSACTION_MAX_WAIT_MS=5000
DATABASE_TRANSACTION_TIMEOUT_MS=20000

# JSON object mapping key IDs to canonical base64-encoded 32-byte keys.
# Generate keys with a secrets manager or: openssl rand -base64 32
ENCRYPTION_KEYS_JSON={"2026-01":"REPLACE_WITH_BASE64_32_BYTE_KEY"}
CURRENT_ENCRYPTION_KEY_ID=2026-01

OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=https://api.example.com
WEB_APP_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

# Set to the number of trusted reverse-proxy hops in the deployment.
TRUST_PROXY_HOPS=0
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_REQUESTS=60
HARDSHIP_RATE_LIMIT_REQUESTS=10
UPLOAD_RATE_LIMIT_REQUESTS=10
